package editor

import (
	"net/url"
	"strconv"
)

// relationsPanel is the right panel's body: the entity's edges by role group.
// Every edit swaps the whole panel, so row indexes are never stale.
templ relationsPanel(p relPanel) {
	<div class="lk-rel" id="lk-rel-panel">
		if p.Err != "" {
			<p class="lk-rel-err" role="alert">{ p.Err }</p>
		}
		for _, g := range p.Groups {
			<section class="lk-rel-group">
				<h3 class="lk-rel-head">{ g.Label }</h3>
				for _, row := range g.Rows {
					@relRowView(p, row)
				}
			</section>
		}
		if len(p.Groups) == 0 {
			<p class="lk-empty">No relations yet.</p>
		}
		@relPicker(p)
	</div>
}

// relPicker is "+ link": a search over names and aliases, target first; the
// relation is asked for only when the pack allows more than one.
templ relPicker(p relPanel) {
	<details class="lk-rel-picker">
		<summary>+ link</summary>
		<input
			type="search"
			name="q"
			class="lk-rel-search"
			placeholder="Find or create…"
			autocomplete="off"
			aria-label="Find an entity to link"
			hx-get={ relURL(p.ID, p.Tabs, "search", nil) }
			hx-trigger="keyup changed delay:200ms, search"
			hx-target="#lk-rel-hits"
			hx-swap="innerHTML"
		/>
		<ul class="lk-rel-hits" id="lk-rel-hits"></ul>
	</details>
}

// relHits are the search results: each hit by name and type, greyed out when
// no relation joins the two types, then "Create" for the typed name.
templ relHits(m relSearch) {
	for _, h := range m.Hits {
		<li>
			if len(h.Choices) == 0 {
				<div class="lk-hit lk-off" aria-disabled="true">
					<span>{ h.Name }</span>
					<span class="lk-hit-type">{ h.Type }</span>
					<span class="lk-hit-why">no relation between { m.SrcType } and { h.Type }</span>
				</div>
			} else {
				<button
					type="button"
					class="lk-hit"
					hx-post={ relURL(m.ID, m.Tabs, "link", url.Values{"target": {h.ID}}) }
					hx-target="#lk-rel-panel"
					hx-swap="outerHTML"
				>
					<span>{ h.Name }</span>
					<span class="lk-hit-type">{ h.Type }</span>
				</button>
			}
		</li>
	}
	<li>
		if len(m.Types) == 0 {
			<div class="lk-hit lk-off" aria-disabled="true">
				<span>Create “{ m.Query }”</span>
				<span class="lk-hit-why">no relation from { m.SrcType } to any type</span>
			</div>
		} else {
			<form
				class="lk-rel-create"
				hx-post={ relURL(m.ID, m.Tabs, "create", nil) }
				hx-target="#lk-rel-panel"
				hx-swap="outerHTML"
			>
				<input type="hidden" name="name" value={ m.Query }/>
				if len(m.Types) == 1 {
					<input type="hidden" name="type" value={ m.Types[0] }/>
				} else {
					<select name="type" required aria-label="Type of the new entity">
						<option value="" disabled selected>type…</option>
						for _, t := range m.Types {
							<option value={ t }>{ t }</option>
						}
					</select>
				}
				<button type="submit" class="btn">Create “{ m.Query }”</button>
			</form>
		}
	</li>
}

// relAskView asks which relation to add, when the pack allows several: each
// coloured by its role and labelled with the role tag.
templ relAskView(a relAsk) {
	<li class="lk-rel-ask">Link { a.Name } as</li>
	for _, c := range a.Choices {
		<li>
			<button
				type="button"
				class="lk-hit"
				hx-post={ a.URL(c.Name) }
				hx-target="#lk-rel-panel"
				hx-swap="outerHTML"
			>
				<span class={ "lk-rel-name", c.Class }>{ c.Name }</span>
				<span class="lk-hit-type">{ c.Role }</span>
			</button>
		</li>
	}
}

// relCreated is the panel after a create, with the tab strip out of band:
// the new entity's background tab.
templ relCreated(p relPanel, strip templ.Component) {
	@relationsPanel(p)
	@strip
}

// relRowView is one edge. An authored one is edited on the row and saved
// with the entity; a derived or inbound one says where it comes from.
templ relRowView(p relPanel, row relRow) {
	<div class={ "lk-rel-row", templ.KV("lk-rel-derived", row.Index < 0) }>
		<div class="lk-rel-line">
			<span class={ "lk-rel-name", row.Class }>{ row.Relation }</span>
			if row.Linked {
				<a
					class="lk-rel-target"
					href={ templ.SafeURL(p.Tabs.Open(row.Target).URL()) }
					data-new-tab={ p.Tabs.Add(row.Target).URL() }
				>{ row.Name }</a>
			} else {
				<span class="lk-rel-absent">{ row.Name }</span>
			}
			if row.Index >= 0 {
				<button
					type="button"
					class="lk-x lk-rel-remove"
					title="Remove"
					hx-post={ rowURL(p.ID, p.Tabs, row.Index, "remove") }
					hx-target="#lk-rel-panel"
					hx-swap="outerHTML"
				>×</button>
			}
		</div>
		if row.Index >= 0 {
			<div class="lk-rel-fields">
				<input
					type="number"
					name="priority"
					class="lk-rel-priority"
					value={ row.Priority }
					placeholder="priority"
					aria-label="Priority"
					hx-post={ rowURL(p.ID, p.Tabs, row.Index, "priority") }
					hx-trigger="change"
					hx-target="#lk-rel-panel"
					hx-swap="outerHTML"
				/>
				<input
					type="text"
					name="note"
					class="lk-rel-note"
					value={ row.Note }
					placeholder="note"
					aria-label="Note"
					hx-post={ rowURL(p.ID, p.Tabs, row.Index, "note") }
					hx-trigger="change"
					hx-target="#lk-rel-panel"
					hx-swap="outerHTML"
				/>
			</div>
			@conditionChips(CondTarget{Entity: p.ID, Path: []string{"relations", strconv.Itoa(row.Index), "valid_in"}, Conds: row.Conds})
		} else {
			<div class="lk-rel-from">{ row.From }</div>
			if row.Priority != "" || row.Note != "" {
				<div class="lk-rel-from">
					if row.Priority != "" {
						priority { row.Priority }
					}
					if row.Priority != "" && row.Note != "" {
						·
					}
					{ row.Note }
				</div>
			}
		}
	</div>
}

// relPanelError is a panel that could not be read.
templ relPanelError(id string, msg string) {
	<div class="lk-rel" id="lk-rel-panel" data-entity={ id }>
		<p class="lk-rel-err" role="alert">{ msg }</p>
	</div>
}
